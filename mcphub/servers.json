{
  "mcpServers": {
    "perplexity": {
      "args": ["-y", "perplexity-mcp"],
      "env": {
        "PERPLEXITY_API_KEY": "YOUR_API_KEY"
      },
      "command": "npx"
    },
    "filesystem": {
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/root",
        "/synosrc"
      ],
      "disabled": false,
      "command": "npx"
    }
  },
  "nativeMCPServers": []
}

